type PostgresRepo struct {
	Pool *pgxpool.Pool
}

func NewRepo(appConfig *config.Config, ctx context.Context) (*PostgresRepo, error) {
	cfg, err := pgxpool.ParseConfig(appConfig.Dsn)
	if err != nil {
		return nil, err
	}

	cfg.MaxConns = appConfig.MaxConns

	pool, err := pgxpool.NewWithConfig(ctx, cfg)
	if err != nil {
		return nil, err
	}

	err = pool.Ping(ctx)
	if err != nil {
		return nil, err
	}

	return &PostgresRepo{
		Pool: pool,
	}, nil
}

