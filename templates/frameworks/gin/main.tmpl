package main

import (
	"context"
	"log"

	"{{.AppName}}/config"
	"{{.AppName}}/internal/repository/postgres"
	"{{.AppName}}/internal/routes"
	"{{.AppName}}/internal/usecases"

	"github.com/fvbock/endless"
	"github.com/gin-gonic/gin"
)

func main() {
	// 1. Load configuration from .env
	cfg, err := config.Load()
	if err != nil {
		log.Fatalln(err)
	}

	// 2. In production, enable Gin release mode
	if cfg.Env == "prod" {
		gin.SetMode(gin.ReleaseMode)
	}

	// 3. Create router with middleware
	router := gin.New()
	router.Use(gin.Logger())
	router.Use(gin.Recovery())

	// 4. Initialize dependencies
	repo, err := postgres.NewRepo(cfg, context.Background())
	if err != nil {
		log.Fatalln(err)
	}

	usecases := usecases.NewCases(repo)
	routes := routes.NewHTTPRoutes(usecases)

	// 5. Register routes
	router.GET("/ping", routes.Ping)

	api := router.Group("/users")
	{
		api.POST("", routes.CreateUser)
		api.GET("", routes.ListUsers)
		api.GET("/:id", routes.GetUser)
		api.PUT("/:id", routes.UpdateUser)
		api.DELETE("/:id", routes.DeleteUser)
	}

	// 6. Start server with graceful shutdown
	if err := endless.ListenAndServe(cfg.Port, router); err != nil {
		log.Fatalln(err)
	}
}
