package main

import (
	"context"
	"log"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{.AppName}}/config"
	"{{.AppName}}/internal/repository/postgres"
	"{{.AppName}}/internal/routes"
	"{{.AppName}}/internal/usecases"
)

func main() {
	// 1. Load configuration from .env
	cfg, err := config.Load()
	if err != nil {
		log.Fatalln(err)
	}

	// 2. Initialize dependencies
	repo, err := postgres.NewRepo(cfg, context.Background())
	if err != nil {
		log.Fatalln(err)
	}

	usecases := usecases.NewCases(repo)
	mux := routes.NewServeMux(usecases)

	// 3. Create HTTP server
	srv := &http.Server{
		Addr:    cfg.Port,
		Handler: mux,
	}

	// 4. Graceful shutdown
	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)

	go func() {
		log.Printf("Server starting on %s", cfg.Port)
		if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			log.Fatalln(err)
		}
	}()

	<-quit
	log.Println("Shutting down server...")

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	if err := srv.Shutdown(ctx); err != nil {
		log.Fatalln(err)
	}
}
