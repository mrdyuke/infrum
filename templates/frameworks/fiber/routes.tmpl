package routes

import (
	"{{.AppName}}/internal/domain"

	"github.com/gofiber/fiber/v2"
)

// HTTPRoutes — HTTP handler layer.
type HTTPRoutes struct {
	Usecases domain.UseCases
}

func Register(app *fiber.App, usecases domain.UseCases) {
	r := &HTTPRoutes{Usecases: usecases}

	app.Get("/ping", r.Ping)

	users := app.Group("/users")
	{
		users.Post("", r.CreateUser)
		users.Get("", r.ListUsers)
		users.Get("/:id", r.GetUser)
		users.Put("/:id", r.UpdateUser)
		users.Delete("/:id", r.DeleteUser)
	}
}

// Ping — health check endpoint.
func (r *HTTPRoutes) Ping(c *fiber.Ctx) error {
	return c.SendStatus(fiber.StatusOK)
}

// CreateUser — POST /users
func (r *HTTPRoutes) CreateUser(c *fiber.Ctx) error {
	var req domain.CreateUserReq
	if err := c.BodyParser(&req); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": err.Error()})
	}

	user, err := r.Usecases.CreateUser(c.Context(), req)
	if err != nil {
		return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": err.Error()})
	}

	return c.Status(fiber.StatusCreated).JSON(user)
}

// GetUser — GET /users/:id
func (r *HTTPRoutes) GetUser(c *fiber.Ctx) error {
	id := c.Params("id")

	user, err := r.Usecases.GetUser(c.Context(), id)
	if err != nil {
		return c.Status(fiber.StatusNotFound).JSON(fiber.Map{"error": err.Error()})
	}

	return c.JSON(user)
}

// ListUsers — GET /users
func (r *HTTPRoutes) ListUsers(c *fiber.Ctx) error {
	users, err := r.Usecases.ListUsers(c.Context())
	if err != nil {
		return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": err.Error()})
	}

	return c.JSON(users)
}

// UpdateUser — PUT /users/:id
func (r *HTTPRoutes) UpdateUser(c *fiber.Ctx) error {
	var req domain.UpdateUserReq
	if err := c.BodyParser(&req); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": err.Error()})
	}

	req.ID = c.Params("id")

	user, err := r.Usecases.UpdateUser(c.Context(), req)
	if err != nil {
		return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": err.Error()})
	}

	return c.JSON(user)
}

// DeleteUser — DELETE /users/:id
func (r *HTTPRoutes) DeleteUser(c *fiber.Ctx) error {
	id := c.Params("id")

	if err := r.Usecases.DeleteUser(c.Context(), id); err != nil {
		return c.Status(fiber.StatusNotFound).JSON(fiber.Map{"error": err.Error()})
	}

	return c.SendStatus(fiber.StatusNoContent)
}
