package main

import (
	"context"
	"log"

	"{{.AppName}}/config"
	"{{.AppName}}/internal/repository/postgres"
	"{{.AppName}}/internal/routes"
	"{{.AppName}}/internal/usecases"

	"github.com/gofiber/fiber/v2"
	"github.com/gofiber/fiber/v2/middleware/logger"
	"github.com/gofiber/fiber/v2/middleware/recover"
)

func main() {
	// 1. Load configuration from .env
	cfg, err := config.Load()
	if err != nil {
		log.Fatalln(err)
	}

	// 2. Create Fiber app
	app := fiber.New()

	// 3. Middleware
	app.Use(logger.New())
	app.Use(recover.New())

	// 4. Initialize dependencies
	repo, err := postgres.NewRepo(cfg, context.Background())
	if err != nil {
		log.Fatalln(err)
	}

	usecases := usecases.NewCases(repo)
	routes.Register(app, usecases)

	// 5. Start server
	log.Fatal(app.Listen(cfg.Port))
}
