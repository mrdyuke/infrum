package routes

import (
	"{{.AppName}}/internal/domain"
	"net/http"

	"github.com/labstack/echo/v4"
)

type HTTPRoutes struct {
	Usecases domain.UseCases
}

func Register(e *echo.Echo, usecases domain.UseCases) {
	r := &HTTPRoutes{Usecases: usecases}

	e.GET("/ping", r.Ping)
}

func (r *HTTPRoutes) Ping(c echo.Context) error {
	return c.NoContent(http.StatusOK)
}
